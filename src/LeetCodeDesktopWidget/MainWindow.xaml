                        <TextBlock Text="{Binding YearActiveDays}" FontSize="10" FontWeight="SemiBold" Foreground="#EEEEEE"/>
                        <TextBlock Text=" active days  ·  " FontSize="10" Foreground="#707070"/>
                        <TextBlock Text="{Binding YearAverageText}" FontSize="10" FontWeight="SemiBold" Foreground="#EEEEEE"/>
                        <TextBlock Text="/day avg" FontSize="10" Foreground="#707070"/>
                        <TextBlock Text="  |  " FontSize="10" Foreground="#303030" Margin="6,0"/>
                        <TextBlock Text="{Binding HoverInfoText}" FontSize="10" Foreground="#A0A0A0" MaxWidth="400" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="Less" FontSize="9" Foreground="#707070" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <Rectangle Width="9" Height="9" RadiusX="1.5" RadiusY="1.5" Fill="#222222" Stroke="#303030" StrokeThickness="0.8" Margin="2,0"/>
                        <Rectangle Width="9" Height="9" RadiusX="1.5" RadiusY="1.5" Fill="#0E3A22" Margin="2,0"/>
                        <Rectangle Width="9" Height="9" RadiusX="1.5" RadiusY="1.5" Fill="#186334" Margin="2,0"/>
                        <Rectangle Width="9" Height="9" RadiusX="1.5" RadiusY="1.5" Fill="#238C44" Margin="2,0"/>
                        <Rectangle Width="9" Height="9" RadiusX="1.5" RadiusY="1.5" Fill="#2EB856" Margin="2,0"/>
                        <TextBlock Text="More" FontSize="9" Foreground="#707070" Margin="5,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </DataTemplate>

        <!-- PRESET 4: LARGE (6×3, 1180×410) -->
        <DataTemplate x:Key="LargePresetTemplate">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Row 0: Top Bar -->
                    <RowDefinition Height="Auto"/> <!-- Row 1: 5 Tactile Metric Cards -->
                    <RowDefinition Height="Auto"/> <!-- Row 2: Activity Header Line -->
                    <RowDefinition Height="*"/>    <!-- Row 3: Heatmap (Spacious 16.5px cells) -->
                    <RowDefinition Height="Auto"/> <!-- Row 4: Footer -->
                </Grid.RowDefinitions>

                <!-- Row 0: Top Bar -->
                <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="True">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Background="Transparent"
                                Cursor="SizeAll" ToolTip="Click and drag to move widget"
                                MouseLeftButtonDown="OnDragHandleMouseLeftButtonDown" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="#606060" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="Desktop Layer"/>
                        <TextBlock Text="LEETCODE" FontSize="11" FontWeight="Bold" Foreground="#A0A0A0" VerticalAlignment="Center"/>
                        <TextBlock Text=" ⋮⋮" FontSize="12" FontWeight="Bold" Foreground="#505050" VerticalAlignment="Center" Margin="5,0,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <ComboBox ItemsSource="{Binding AvailableYears}"
                                  SelectedItem="{Binding SelectedYear, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Visibility="{Binding HasAvailableYears, Converter={StaticResource BoolToVis}}"
                                  Style="{StaticResource DarkYearComboBox}"
                                  Width="76" Height="26" Margin="0,0,6,0"/>

                        <Button Content="↻" Command="{Binding RefreshCommand}" 
                                IsEnabled="{Binding IsSyncing, Converter={StaticResource InverseBoolToVis}}"
                                ToolTip="Refresh from LeetCode" Style="{StaticResource DarkIconButton}" 
                                Width="30" Height="26" FontSize="12" FontWeight="Bold" Margin="0,0,6,0"/>

                        <Button Content="⚙" Command="{Binding OpenSettingsCommand}" 
                                ToolTip="Settings" Style="{StaticResource DarkIconButton}"
                                Width="30" Height="26" FontSize="11"/>
                    </StackPanel>

                    <Border Background="Transparent" Cursor="SizeAll" ToolTip="Click and drag to move widget"
                            MouseLeftButtonDown="OnDragHandleMouseLeftButtonDown"/>
                </DockPanel>

                <!-- Row 1: 5 Tactile Metric Cards -->
                <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,8">
                    <!-- Card 1: Identity & Total Solved -->
                    <Border Background="#222222" BorderBrush="#303030" BorderThickness="1" CornerRadius="5" Padding="12,8" Margin="0,0,6,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="@" FontSize="11" Foreground="#707070"/>
                                <TextBlock Text="{Binding DisplayUsername}" FontSize="11.5" FontWeight="Bold" Foreground="#EEEEEE"
                                           MaxWidth="140" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Text="{Binding TotalSolved}" FontSize="24" FontWeight="Bold" Foreground="#EEEEEE"/>
                            <TextBlock Text="TOTAL SOLVED" FontSize="9" FontWeight="Bold" Foreground="#707070"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 2: Easy -->
                    <Border Background="#222222" BorderBrush="#303030" BorderThickness="1" CornerRadius="5" Padding="12,8" Margin="3,0,3,0">
                        <StackPanel>
                            <TextBlock Text="EASY" FontSize="9.5" FontWeight="Bold" Foreground="#A0A0A0" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding EasySolved}" FontSize="24" FontWeight="Bold" Foreground="#EEEEEE"/>
                            <TextBlock Text="PROBLEMS" FontSize="9" Foreground="#707070"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 3: Medium -->
                    <Border Background="#222222" BorderBrush="#303030" BorderThickness="1" CornerRadius="5" Padding="12,8" Margin="3,0,3,0">
                        <StackPanel>
                            <TextBlock Text="MEDIUM" FontSize="9.5" FontWeight="Bold" Foreground="#A0A0A0" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding MediumSolved}" FontSize="24" FontWeight="Bold" Foreground="#EEEEEE"/>
                            <TextBlock Text="PROBLEMS" FontSize="9" Foreground="#707070"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 4: Hard -->
                    <Border Background="#222222" BorderBrush="#303030" BorderThickness="1" CornerRadius="5" Padding="12,8" Margin="3,0,3,0">
                        <StackPanel>
                            <TextBlock Text="HARD" FontSize="9.5" FontWeight="Bold" Foreground="#A0A0A0" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding HardSolved}" FontSize="24" FontWeight="Bold" Foreground="#EEEEEE"/>
                            <TextBlock Text="PROBLEMS" FontSize="9" Foreground="#707070"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 5: Streak -->
                    <Border Background="#222222" BorderBrush="#303030" BorderThickness="1" CornerRadius="5" Padding="12,8" Margin="6,0,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="🔥 " FontSize="10"/>
                                <TextBlock Text="ACTIVE STREAK" FontSize="9.5" FontWeight="Bold" Foreground="#A0A0A0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding CurrentStreak}" FontSize="24" FontWeight="Bold" Foreground="#EEEEEE"/>
                                <TextBlock Text=" DAYS" FontSize="11" FontWeight="SemiBold" Foreground="#707070" VerticalAlignment="Bottom" Margin="4,0,0,3"/>
                            </StackPanel>
                            <TextBlock Text="{Binding StreakSummaryText, Mode=OneWay}" FontSize="9" Foreground="#707070"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Row 2: Activity Header Line -->
                <DockPanel Grid.Row="2" Margin="2,4,2,4">
                    <TextBlock Text="activity" FontSize="10.5" FontWeight="SemiBold" Foreground="#A0A0A0" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                    <Rectangle Height="1" Fill="#303030" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </DockPanel>

                <!-- Row 3: Heatmap -->
                <views:HeatmapControl Grid.Row="3"
                                      Activity="{Binding CurrentActivity}"
                                      HoveredSubmission="{Binding HoveredDay, Mode=TwoWay}"
                                      CellSize="16.5"
                                      CellSpacing="4.0"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      Margin="0,1"/>

                <!-- Row 4: Footer -->
                <DockPanel Grid.Row="4" Margin="2,6,2,0">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedYear}" FontSize="10.5" FontWeight="Bold" Foreground="#EEEEEE"/>
                        <TextBlock Text=" activity  ·  " FontSize="10.5" Foreground="#707070"/>
                        <TextBlock Text="{Binding YearSubmissions}" FontSize="10.5" FontWeight="SemiBold" Foreground="#EEEEEE"/>
                        <TextBlock Text=" submissions  ·  " FontSize="10.5" Foreground="#707070"/>
                        <TextBlock Text="{Binding YearActiveDays}" FontSize="10.5" FontWeight="SemiBold" Foreground="#EEEEEE"/>
                        <TextBlock Text=" active days  ·  " FontSize="10.5" Foreground="#707070"/>
                        <TextBlock Text="{Binding YearAverageText}" FontSize="10.5" FontWeight="SemiBold" Foreground="#EEEEEE"/>
                        <TextBlock Text="/day avg" FontSize="10.5" Foreground="#707070"/>
                        <TextBlock Text="  |  " FontSize="10.5" Foreground="#303030" Margin="8,0"/>
                        <TextBlock Text="{Binding HoverInfoText}" FontSize="10.5" Foreground="#A0A0A0" MaxWidth="450" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="Less" FontSize="9" Foreground="#707070" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <Rectangle Width="10" Height="10" RadiusX="1.5" RadiusY="1.5" Fill="#222222" Stroke="#303030" StrokeThickness="0.8" Margin="2.5,0"/>
                        <Rectangle Width="10" Height="10" RadiusX="1.5" RadiusY="1.5" Fill="#0E3A22" Margin="2.5,0"/>
                        <Rectangle Width="10" Height="10" RadiusX="1.5" RadiusY="1.5" Fill="#186334" Margin="2.5,0"/>
                        <Rectangle Width="10" Height="10" RadiusX="1.5" RadiusY="1.5" Fill="#238C44" Margin="2.5,0"/>
                        <Rectangle Width="10" Height="10" RadiusX="1.5" RadiusY="1.5" Fill="#2EB856" Margin="2.5,0"/>
                        <TextBlock Text="More" FontSize="9" Foreground="#707070" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <!-- Main Widget Surface: Strict Neutral Dark Charcoal with Subtle Border -->
    <Border Background="#191919"
            BorderBrush="#303030"
            BorderThickness="1"
            CornerRadius="10"
            Padding="16,12"
            SnapsToDevicePixels="True">

        <!-- Right-Click Context Menu -->
        <Border.ContextMenu>
            <ContextMenu Style="{StaticResource DarkContextMenu}">
                <MenuItem Header="Open LeetCode Profile" Command="{Binding OpenLeetCodeProfileCommand}"/>
                <MenuItem Header="Open Daily Challenge" Command="{Binding OpenDailyChallengeCommand}"/>
                <MenuItem Header="Open Contest" Command="{Binding OpenContestCommand}"/>
                <Separator Style="{StaticResource DarkMenuSeparator}"/>
                <MenuItem Header="Refresh from LeetCode" Command="{Binding RefreshCommand}"/>
                <MenuItem Header="Settings..." Command="{Binding OpenSettingsCommand}"/>
                <MenuItem Header="Widget Size">
                    <MenuItem Header="Compact (2×2)" IsCheckable="True" IsChecked="{Binding IsCompactPreset, Mode=OneWay}"
                              Command="{Binding SelectPresetCommand}" CommandParameter="{x:Static models:WidgetPreset.Compact}"/>
                    <MenuItem Header="Standard (4×2)" IsCheckable="True" IsChecked="{Binding IsStandardPreset, Mode=OneWay}"
                              Command="{Binding SelectPresetCommand}" CommandParameter="{x:Static models:WidgetPreset.Standard}"/>
                    <MenuItem Header="Wide (6×2)" IsCheckable="True" IsChecked="{Binding IsWidePreset, Mode=OneWay}"
                              Command="{Binding SelectPresetCommand}" CommandParameter="{x:Static models:WidgetPreset.Wide}"/>
                    <MenuItem Header="Large (6×3)" IsCheckable="True" IsChecked="{Binding IsLargePreset, Mode=OneWay}"
                              Command="{Binding SelectPresetCommand}" CommandParameter="{x:Static models:WidgetPreset.Large}"/>
                </MenuItem>
                <Separator Style="{StaticResource DarkMenuSeparator}"/>
                <MenuItem Header="Reset Position" Command="{Binding ResetPositionCommand}"/>
                <Separator Style="{StaticResource DarkMenuSeparator}"/>
                <MenuItem Header="Exit" Command="{Binding ExitApplicationCommand}"/>
            </ContextMenu>
        </Border.ContextMenu>

        <Grid>
            <!-- ============================================================= -->
            <!-- 1. ACTIVE VERIFIED WIDGET SURFACE (Adaptive Presets)          -->
            <!-- ============================================================= -->
            <ContentControl Content="{Binding}"
                            Visibility="{Binding IsAccountVerified, Converter={StaticResource BoolToVis}}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="ContentTemplate" Value="{StaticResource StandardPresetTemplate}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentPreset}" Value="{x:Static models:WidgetPreset.Compact}">
                                <Setter Property="ContentTemplate" Value="{StaticResource CompactPresetTemplate}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CurrentPreset}" Value="{x:Static models:WidgetPreset.Standard}">
                                <Setter Property="ContentTemplate" Value="{StaticResource StandardPresetTemplate}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CurrentPreset}" Value="{x:Static models:WidgetPreset.Wide}">
                                <Setter Property="ContentTemplate" Value="{StaticResource WidePresetTemplate}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CurrentPreset}" Value="{x:Static models:WidgetPreset.Large}">
                                <Setter Property="ContentTemplate" Value="{StaticResource LargePresetTemplate}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>

            <!-- ============================================================= -->
            <!-- 2. MINIMAL ONBOARDING SURFACE (Unverified state)               -->
            <!-- ============================================================= -->
            <Grid Visibility="{Binding IsAccountVerified, Converter={StaticResource InverseBoolToVis}}"
                  VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="500">
                    <!-- Brand Drag Handle -->
                    <StackPanel x:Name="OnboardingBrandDragArea" 
                                Orientation="Horizontal" 
                                HorizontalAlignment="Center" 
                                Background="Transparent"
                                Cursor="SizeAll"
                                ToolTip="Click and drag to move widget"
                                MouseLeftButtonDown="OnDragHandleMouseLeftButtonDown"
                                Margin="0,0,0,16">
                        <Ellipse x:Name="OnboardingStatusDot" Width="7.5" Height="7.5" Fill="#606060" Margin="0,0,7,0" VerticalAlignment="Center" ToolTip="Desktop Layer"/>
                        <TextBlock Text="LEETCODE" FontSize="10" FontWeight="Bold" Foreground="#A0A0A0" VerticalAlignment="Center"/>
                        <TextBlock Text=" ⋮⋮" FontSize="11" FontWeight="Bold" Foreground="#505050" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </StackPanel>

                    <!-- Title -->
                    <TextBlock Text="CONNECT YOUR ACCOUNT" FontSize="14" FontWeight="Bold" Foreground="#EEEEEE"
                               HorizontalAlignment="Center" Margin="0,0,0,6"/>

                    <!-- Subtitle / Explanation -->
                    <TextBlock Text="Your activity and streaks will appear here once your account is verified."
                               FontSize="11" Foreground="#A0A0A0" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,16"/>

                    <!-- Input + Action -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                        <TextBox x:Name="OnboardingUsernameBox"
                                 Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DarkInputBox}"
                                 Width="200" FontSize="11.5" Padding="8,5" ToolTip="Enter LeetCode username">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding StartVerificationCommand}"/>
                                <KeyBinding Key="Enter" Command="{Binding StartVerificationCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Content="Verify Ownership" Command="{Binding StartVerificationCommand}"
                                Style="{StaticResource PrimaryActionButton}" Margin="8,0,0,0" FontSize="11.5"/>
                    </StackPanel>

                    <!-- Status / Error Text -->
                    <TextBlock Text="{Binding VerificationStatusText}"
                               Visibility="{Binding VerificationStatusText, Converter={StaticResource StringNotEmptyToVis}}"
                               FontSize="10.5" Foreground="#A0A0A0" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="440" TextAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- ============================================================= -->
            <!-- 3. ACCOUNT OWNERSHIP VERIFICATION OVERLAY                      -->
            <!-- ============================================================= -->
            <Border Background="#191919" 
                    BorderBrush="#303030" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Visibility="{Binding IsVerificationPromptOpen, Converter={StaticResource BoolToVis}}"
                    Padding="22,14"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="True">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center"
                                    Background="Transparent" Cursor="SizeAll" ToolTip="Click and drag to move widget"
                                    MouseLeftButtonDown="OnDragHandleMouseLeftButtonDown">
                            <TextBlock Text="ACCOUNT OWNERSHIP VERIFICATION" FontSize="10.5" FontWeight="Bold" Foreground="#EEEEEE"/>
                            <TextBlock Text=" — @" FontSize="10.5" Foreground="#707070"/>
                            <TextBlock Text="{Binding Username}" FontSize="11" FontWeight="Bold" Foreground="#EEEEEE"/>
                            <TextBlock Text=" ⋮⋮" FontSize="11" FontWeight="Bold" Foreground="#505050" Margin="5,0,0,0"/>
                        </StackPanel>
                        <Button Content="✕" Command="{Binding CancelVerificationCommand}" DockPanel.Dock="Right"
                                HorizontalAlignment="Right" Style="{StaticResource DarkIconButton}" Width="28" Height="26" FontSize="10" ToolTip="Close (Esc)"/>
                    </DockPanel>

                    <!-- Instructions -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,8">
                        <TextBlock Text="1. Copy your temporary challenge token below (valid for 15 minutes):" 
                                   FontSize="10.5" Foreground="#A0A0A0" Margin="0,0,0,4"/>
                        <Border Background="#222222" BorderBrush="#303030" BorderThickness="1" CornerRadius="4" Padding="10,4" Margin="0,0,0,8">
                            <DockPanel>
                                <Button Content="📋 Copy" Command="{Binding CopyVerificationTokenCommand}" 
                                        DockPanel.Dock="Right" Style="{StaticResource DarkIconButton}" Padding="10,3" Margin="8,0,0,0" FontSize="10.5" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding VerificationToken, Mode=OneWay}" IsReadOnly="True" 
                                         Background="Transparent" Foreground="#EEEEEE" FontFamily="Consolas, monospace" FontSize="11.5" BorderThickness="0" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>

                        <DockPanel Margin="0,0,0,6">
                            <Button Content="↗ Open LeetCode Profile" Command="{Binding OpenLeetCodeProfileCommand}"
                                    DockPanel.Dock="Right" Style="{StaticResource SecondaryActionButton}" Padding="10,3" Margin="8,0,0,0" FontSize="10.5" FontWeight="SemiBold"
                                    ToolTip="Opens https://leetcode.com/profile in your default browser"/>
                            <TextBlock Text="2. Paste the token into your LeetCode profile 'About Me' bio:" 
                                       FontSize="10.5" Foreground="#A0A0A0" VerticalAlignment="Center"/>
                        </DockPanel>

                        <TextBlock Text="3. Click 'Save' on LeetCode, then click 'Verify Ownership' below." 
                                   FontSize="10.5" Foreground="#A0A0A0" Margin="0,0,0,2"/>
                        <TextBlock Text="(You can safely remove the token from your profile immediately after verification.)" 
                                   FontSize="9.5" FontStyle="Italic" Foreground="#707070"/>
                    </StackPanel>

                    <!-- Status message -->
                    <TextBlock Grid.Row="2" Text="{Binding VerificationStatusText}" FontSize="10.5" Foreground="#A0A0A0" TextWrapping="Wrap" Margin="0,0,0,8"/>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Command="{Binding CancelVerificationCommand}" 
                                Style="{StaticResource DarkIconButton}" Margin="0,0,8,0" Padding="12,4" FontSize="11"/>
                        <Button Content="Verify Ownership" Command="{Binding CheckVerificationCommand}" 
                                IsEnabled="{Binding IsVerifying, Converter={StaticResource InverseBoolToVis}}"
                                Style="{StaticResource PrimaryActionButton}" Padding="16,4" FontSize="11"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================================================= -->
            <!-- 4. RESTRAINED NEUTRAL SETTINGS MODAL OVERLAY                  -->
            <!-- ============================================================= -->
            <Border Background="#E6101010"
                    CornerRadius="8"
                    Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVis}}"
                    MouseLeftButtonDown="OnSettingsBackdropMouseLeftButtonDown"
                    SnapsToDevicePixels="True">
                <Border Background="#191919"
                        BorderBrush="#303030"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,10"
                        MaxWidth="460"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MouseLeftButtonDown="OnSettingsCardMouseLeftButtonDown"
                        SnapsToDevicePixels="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Header -->
                            <RowDefinition Height="Auto"/> <!-- Section 1: Widget Size -->
                            <RowDefinition Height="Auto"/> <!-- Section 2: Refresh Interval -->
                            <RowDefinition Height="Auto"/> <!-- Section 3: Account & Data -->
                            <RowDefinition Height="Auto"/> <!-- Section 4: Desktop & Position -->
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="True">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                <TextBlock Text="SETTINGS" FontSize="10.5" FontWeight="Bold" Foreground="#EEEEEE"/>
                            </StackPanel>
                            <Button Content="✕" Command="{Binding CloseSettingsCommand}" DockPanel.Dock="Right"
                                    Style="{StaticResource DarkIconButton}" Width="28" Height="26" FontSize="10" ToolTip="Close (Esc)"/>
                        </DockPanel>

                        <!-- Section 1: Widget Size Presets -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,7">
                            <TextBlock Text="WIDGET SIZE" FontSize="8.5" FontWeight="Bold" Foreground="#707070" Margin="0,0,0,4"/>
                            <UniformGrid Columns="4">
                                <!-- Compact -->
                                <Button Command="{Binding SelectPresetCommand}" CommandParameter="{x:Static models:WidgetPreset.Compact}"
                                        Padding="6,3" Margin="0,0,3,0">
                                    <Button.Style>
                                        <Style BasedOn="{StaticResource PresetPillStyle}" TargetType="Button">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCompactPreset}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#EEEEEE"/>
                                                    <Setter Property="Background" Value="#2E2E2E"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="Compact" FontWeight="SemiBold" FontSize="10" HorizontalAlignment="Center"/>
                                        <TextBlock Text="2×2" FontSize="8" Foreground="#707070" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- Standard -->
                                <Button Command="{Binding SelectPresetCommand}" CommandParameter="{x:Static models:WidgetPreset.Standard}"
                                        Padding="6,3" Margin="2,0,2,0">
                                    <Button.Style>
                                        <Style BasedOn="{StaticResource PresetPillStyle}" TargetType="Button">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsStandardPreset}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#EEEEEE"/>
                                                    <Setter Property="Background" Value="#2E2E2E"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="Standard" FontWeight="SemiBold" FontSize="10" HorizontalAlignment="Center"/>
                                        <TextBlock Text="4×2" FontSize="8" Foreground="#707070" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- Wide -->
                                <Button Command="{Binding SelectPresetCommand}" CommandParameter="{x:Static models:WidgetPreset.Wide}"
                                        Padding="6,3" Margin="2,0,2,0">
                                    <Button.Style>
                                        <Style BasedOn="{StaticResource PresetPillStyle}" TargetType="Button">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsWidePreset}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#EEEEEE"/>
                                                    <Setter Property="Background" Value="#2E2E2E"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="Wide" FontWeight="SemiBold" FontSize="10" HorizontalAlignment="Center"/>
                                        <TextBlock Text="6×2" FontSize="8" Foreground="#707070" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- Large -->
                                <Button Command="{Binding SelectPresetCommand}" CommandParameter="{x:Static models:WidgetPreset.Large}"
                                        Padding="6,3" Margin="3,0,0,0">
                                    <Button.Style>
                                        <Style BasedOn="{StaticResource PresetPillStyle}" TargetType="Button">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLargePreset}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#EEEEEE"/>
                                                    <Setter Property="Background" Value="#2E2E2E"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="Large" FontWeight="SemiBold" FontSize="10" HorizontalAlignment="Center"/>
                                        <TextBlock Text="6×3" FontSize="8" Foreground="#707070" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </UniformGrid>
                        </StackPanel>

                        <!-- Section 2: Refresh Interval -->
                        <StackPanel Grid.Row="2" Margin="0,0,0,7">
                            <TextBlock Text="REFRESH INTERVAL" FontSize="8.5" FontWeight="Bold" Foreground="#707070" Margin="0,0,0,4"/>
                            <UniformGrid Columns="4">
                                <!-- Manual -->
                                <Button Command="{Binding SetRefreshIntervalCommand}" CommandParameter="0"
                                        Padding="6,3" Margin="0,0,3,0">
                                    <Button.Style>
                                        <Style BasedOn="{StaticResource PresetPillStyle}" TargetType="Button">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RefreshIntervalMinutes}" Value="0">
                                                    <Setter Property="BorderBrush" Value="#EEEEEE"/>
                                                    <Setter Property="Background" Value="#2E2E2E"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="Manual" FontWeight="SemiBold" FontSize="10" HorizontalAlignment="Center"/>
                                        <TextBlock Text="On Demand" FontSize="8" Foreground="#707070" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- 15 min -->
                                <Button Command="{Binding SetRefreshIntervalCommand}" CommandParameter="15"
                                        Padding="6,3" Margin="2,0,2,0">
                                    <Button.Style>
                                        <Style BasedOn="{StaticResource PresetPillStyle}" TargetType="Button">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RefreshIntervalMinutes}" Value="15">
                                                    <Setter Property="BorderBrush" Value="#EEEEEE"/>
                                                    <Setter Property="Background" Value="#2E2E2E"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="15 min" FontWeight="SemiBold" FontSize="10" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Interval" FontSize="8" Foreground="#707070" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- 30 min -->
                                <Button Command="{Binding SetRefreshIntervalCommand}" CommandParameter="30"
                                        Padding="6,3" Margin="2,0,2,0">
                                    <Button.Style>
                                        <Style BasedOn="{StaticResource PresetPillStyle}" TargetType="Button">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RefreshIntervalMinutes}" Value="30">
                                                    <Setter Property="BorderBrush" Value="#EEEEEE"/>
                                                    <Setter Property="Background" Value="#2E2E2E"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="30 min" FontWeight="SemiBold" FontSize="10" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Interval" FontSize="8" Foreground="#707070" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- 60 min -->
                                <Button Command="{Binding SetRefreshIntervalCommand}" CommandParameter="60"
                                        Padding="6,3" Margin="3,0,0,0">
                                    <Button.Style>
                                        <Style BasedOn="{StaticResource PresetPillStyle}" TargetType="Button">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RefreshIntervalMinutes}" Value="60">
                                                    <Setter Property="BorderBrush" Value="#EEEEEE"/>
                                                    <Setter Property="Background" Value="#2E2E2E"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="60 min" FontWeight="SemiBold" FontSize="10" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Interval" FontSize="8" Foreground="#707070" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </UniformGrid>
                        </StackPanel>

                        <!-- Section 3: Account & Data -->
                        <Border Grid.Row="3" Background="#222222" BorderBrush="#303030" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,0,7">
                            <DockPanel LastChildFill="True">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <TextBlock Text="ACCOUNT: @" FontSize="9" Foreground="#707070" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding VerifiedUsername}" FontSize="10" FontWeight="Bold" Foreground="#EEEEEE" VerticalAlignment="Center"/>
                                    <Border Visibility="{Binding IsAccountVerified, Converter={StaticResource BoolToVis}}"
                                            Background="#191919" BorderBrush="#303030" BorderThickness="1" CornerRadius="3"
                                            Padding="4,1" Margin="5,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="verified" FontSize="8" FontWeight="SemiBold" Foreground="#A0A0A0"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Content="↗ Profile" Command="{Binding OpenLeetCodeProfileCommand}"
                                            Style="{StaticResource SecondaryActionButton}" Padding="6,2" FontSize="9" Margin="0,0,4,0"/>
                                    <Button Content="↻ Refresh Now" Command="{Binding RefreshCommand}"
                                            Style="{StaticResource SecondaryActionButton}" Padding="6,2" FontSize="9"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Section 4: Desktop & Position (Compact 2-Column Grid) -->
                        <Border Grid.Row="4" Background="#222222" BorderBrush="#303030" BorderThickness="1" CornerRadius="4" Padding="8,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Checkboxes -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <CheckBox Content="Lock position (prevent dragging)"
                                              IsChecked="{Binding IsPositionLocked, Mode=TwoWay}"
                                              Style="{StaticResource DarkCheckBox}" Margin="0,0,0,2"/>
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox Content="Remember position"
                                                  IsChecked="{Binding RememberPosition, Mode=TwoWay}"
                                                  Style="{StaticResource DarkCheckBox}" Margin="0,0,10,0"/>
                                        <CheckBox Content="Start with Windows"
                                                  IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                                                  Style="{StaticResource DarkCheckBox}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Reset & Exit Actions -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Reset Position" Command="{Binding ResetPositionCommand}"
                                            Style="{StaticResource SecondaryActionButton}" Padding="7,3" FontSize="9" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <Button Content="Exit Widget" Command="{Binding ExitApplicationCommand}"
                                            Style="{StaticResource SecondaryActionButton}" Padding="7,3" FontSize="9" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Border>
        </Grid>
    </Border>
</Window>