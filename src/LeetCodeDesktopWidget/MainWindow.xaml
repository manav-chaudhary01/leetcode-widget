<Window x:Class="LeetCodeDesktopWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:LeetCodeDesktopWidget.Views"
        xmlns:vm="clr-namespace:LeetCodeDesktopWidget.ViewModels"
        xmlns:helpers="clr-namespace:LeetCodeDesktopWidget.Helpers"
        mc:Ignorable="d"
        Title="LeetCode Desktop Widget"
        Height="275" Width="845"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="False"
        WindowStartupLocation="Manual"
        Left="60" Top="60">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <helpers:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:BooleanToVisibilityConverter x:Key="InverseBoolToVis" Invert="True"/>

        <!-- Dark minimal ComboBox -->
        <Style x:Key="DarkYearComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#21262D"/>
            <Setter Property="Foreground" Value="#C9D1D9"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, sans-serif"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Dark minimal Button -->
        <Style x:Key="DarkIconButton" TargetType="Button">
            <Setter Property="Background" Value="#21262D"/>
            <Setter Property="Foreground" Value="#C9D1D9"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, sans-serif"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>
    </Window.Resources>

    <Border Background="#F00D1117"
            BorderBrush="#30363D"
            BorderThickness="1"
            CornerRadius="10"
            Padding="14,12"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Header with Username, All-Time Solved Breakdown, and Streaks -->
            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <!-- Left: Branding & Username -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Ellipse x:Name="DesktopStatusDot" Width="9" Height="9" Fill="#238636" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="Desktop Layer"/>
                    <TextBlock Text="LEETCODE" 
                               FontSize="11.5" 
                               FontWeight="Bold" 
                               Foreground="#8B949E" 
                               FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
                               VerticalAlignment="Center"/>

                    <!-- Username Display Mode -->
                    <StackPanel Orientation="Horizontal" 
                                Visibility="{Binding IsEditingUsername, Converter={StaticResource InverseBoolToVis}}"
                                Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Username, TargetNullValue='@configure-user', FallbackValue='@configure-user'}" 
                                   FontSize="11" 
                                   Foreground="#58A6FF" 
                                   VerticalAlignment="Center"
                                   Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding Gesture="LeftClick" Command="{Binding ToggleEditUsernameCommand}"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                        <Button Content="✎" 
                                Command="{Binding ToggleEditUsernameCommand}" 
                                ToolTip="Change LeetCode Username"
                                Style="{StaticResource DarkIconButton}" 
                                Margin="6,0,0,0" 
                                Padding="4,1"
                                FontSize="9"/>
                    </StackPanel>

                    <!-- Username Edit Mode -->
                    <StackPanel Orientation="Horizontal" 
                                Visibility="{Binding IsEditingUsername, Converter={StaticResource BoolToVis}}"
                                Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" 
                                 Width="110" 
                                 FontSize="11" 
                                 Background="#161B22" 
                                 Foreground="#C9D1D9" 
                                 BorderBrush="#30363D" 
                                 Padding="4,2"/>
                        <Button Content="✓" 
                                Command="{Binding SaveUsernameCommand}" 
                                Style="{StaticResource DarkIconButton}" 
                                Margin="4,0,0,0" 
                                Padding="6,1"/>
                    </StackPanel>
                </StackPanel>

                <!-- Right: All-time Stats Badges & Controls -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Difficulty Breakdown Badge -->
                    <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Solved: " FontSize="10.5" Foreground="#8B949E"/>
                            <TextBlock Text="{Binding TotalSolved}" FontSize="10.5" FontWeight="SemiBold" Foreground="#C9D1D9" Margin="0,0,6,0"/>
                            <TextBlock Text="E:" FontSize="10" Foreground="#8B949E"/>
                            <TextBlock Text="{Binding EasySolved}" FontSize="10" Foreground="#3FB950" Margin="1,0,5,0"/>
                            <TextBlock Text="M:" FontSize="10" Foreground="#8B949E"/>
                            <TextBlock Text="{Binding MediumSolved}" FontSize="10" Foreground="#D29922" Margin="1,0,5,0"/>
                            <TextBlock Text="H:" FontSize="10" Foreground="#8B949E"/>
                            <TextBlock Text="{Binding HardSolved}" FontSize="10" Foreground="#F85149" Margin="1,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- All-time Current & Longest Streak -->
                    <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Streak: " FontSize="10.5" Foreground="#8B949E"/>
                            <TextBlock Text="{Binding CurrentStreak}" FontSize="10.5" FontWeight="SemiBold" Foreground="#D29922"/>
                            <TextBlock Text="d " FontSize="10.5" Foreground="#8B949E"/>
                            <TextBlock Text="(Max: " FontSize="10" Foreground="#6E7681"/>
                            <TextBlock Text="{Binding LongestStreak}" FontSize="10" Foreground="#E3B341"/>
                            <TextBlock Text="d)" FontSize="10" Foreground="#6E7681"/>
                        </StackPanel>
                    </Border>

                    <!-- Year Dropdown -->
                    <ComboBox ItemsSource="{Binding AvailableYears}"
                              SelectedItem="{Binding SelectedYear}"
                              Style="{StaticResource DarkYearComboBox}"
                              Width="72"
                              Margin="0,0,6,0"
                              Focusable="False"/>

                    <!-- Refresh Button -->
                    <Button Content="↻" 
                            Command="{Binding RefreshCommand}" 
                            IsEnabled="{Binding IsSyncing, Converter={StaticResource InverseBoolToVis}}"
                            ToolTip="Refresh from LeetCode"
                            Style="{StaticResource DarkIconButton}" 
                            Padding="7,2" 
                            FontWeight="Bold"/>
                </StackPanel>
            </DockPanel>

            <!-- Row 1: Heatmap Grid Canvas -->
            <views:HeatmapControl Grid.Row="1"
                                  Activity="{Binding CurrentActivity}"
                                  HoveredSubmission="{Binding HoveredDay, Mode=TwoWay}"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"/>

            <!-- Row 2: Selected-Year Detailed Statistics Strip -->
            <Border Grid.Row="2" Margin="0,6,0,0" Padding="0,3" BorderBrush="#21262D" BorderThickness="0,1,0,0">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedYear}" FontSize="10.5" FontWeight="SemiBold" Foreground="#58A6FF"/>
                        <TextBlock Text=" Activity:" FontSize="10.5" Foreground="#8B949E" Margin="0,0,8,0"/>

                        <TextBlock Text="{Binding YearSubmissions}" FontSize="10.5" FontWeight="SemiBold" Foreground="#C9D1D9"/>
                        <TextBlock Text=" submissions  •  " FontSize="10.5" Foreground="#6E7681"/>

                        <TextBlock Text="{Binding YearActiveDays}" FontSize="10.5" FontWeight="SemiBold" Foreground="#C9D1D9"/>
                        <TextBlock Text=" active days  •  " FontSize="10.5" Foreground="#6E7681"/>

                        <TextBlock Text="Avg " FontSize="10" Foreground="#6E7681"/>
                        <TextBlock Text="{Binding YearAverageText}" FontSize="10.5" FontWeight="SemiBold" Foreground="#C9D1D9"/>
                        <TextBlock Text="/day  •  " FontSize="10" Foreground="#6E7681"/>

                        <TextBlock Text="Best: " FontSize="10" Foreground="#6E7681"/>
                        <TextBlock Text="{Binding MostActiveDayText}" FontSize="10.5" FontWeight="SemiBold" Foreground="#3FB950"/>
                        <TextBlock Text="  •  " FontSize="10" Foreground="#6E7681"/>

                        <TextBlock Text="Year Streak: " FontSize="10" Foreground="#6E7681"/>
                        <TextBlock Text="{Binding YearLongestStreak}" FontSize="10.5" FontWeight="SemiBold" Foreground="#D29922"/>
                        <TextBlock Text="d" FontSize="10.5" Foreground="#8B949E"/>
                    </StackPanel>

                    <!-- Sync Status / Last Sync Time -->
                    <TextBlock Text="{Binding SyncStatusText}" 
                               FontSize="10" 
                               Foreground="#6E7681" 
                               DockPanel.Dock="Right"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontFamily="Segoe UI Variable, Segoe UI, sans-serif"/>
                </DockPanel>
            </Border>

            <!-- Row 3: Footer: Hover Feedback & 5-Level Legend -->
            <DockPanel Grid.Row="3" Margin="0,6,0,0">
                <!-- Hover Date / Count Feedback -->
                <TextBlock Text="{Binding HoverInfoText}" 
                           FontSize="11" 
                           Foreground="#8B949E" 
                           DockPanel.Dock="Left"
                           VerticalAlignment="Center"
                           FontFamily="Segoe UI Variable, Segoe UI, sans-serif"/>

                <!-- 5-Level Contribution Legend -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Less" FontSize="10" Foreground="#6E7681" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="#161B22" Stroke="#21262D" StrokeThickness="0.5" Margin="2,0"/>
                    <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="#0E4429" Margin="2,0"/>
                    <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="#006D32" Margin="2,0"/>
                    <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="#26A641" Margin="2,0"/>
                    <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="#39D353" Margin="2,0"/>
                    <TextBlock Text="More" FontSize="10" Foreground="#6E7681" Margin="5,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</Window>
