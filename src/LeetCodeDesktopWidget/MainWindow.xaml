<Window x:Class="LeetCodeDesktopWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:LeetCodeDesktopWidget.Views"
        xmlns:vm="clr-namespace:LeetCodeDesktopWidget.ViewModels"
        xmlns:helpers="clr-namespace:LeetCodeDesktopWidget.Helpers"
        mc:Ignorable="d"
        Title="LeetCode Desktop Widget"
        Height="290" Width="845"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="False"
        WindowStartupLocation="Manual"
        Left="60" Top="60"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.BitmapScalingMode="HighQuality"
        RenderOptions.ClearTypeHint="Enabled"
        MouseMove="OnWindowMouseMove"
        MouseLeftButtonUp="OnWindowMouseLeftButtonUp"
        LostMouseCapture="OnWindowLostMouseCapture"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=False}">

    <Window.Resources>
        <helpers:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:BooleanToVisibilityConverter x:Key="InverseBoolToVis" Invert="True"/>
        <helpers:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVis"/>

        <!-- Neutral Minimal ToolTip -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#222222"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="BorderBrush" Value="#303030"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, sans-serif"/>
        </Style>

        <!-- Neutral Input Box Style -->
        <Style x:Key="DarkInputBox" TargetType="TextBox">
            <Setter Property="Background" Value="#222222"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="BorderBrush" Value="#303030"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="#EEEEEE"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, sans-serif"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Validation.ErrorTemplate" Value="{x:Null}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#444444"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#606060"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Neutral Minimal Icon Button -->
        <Style x:Key="DarkIconButton" TargetType="Button">
            <Setter Property="Background" Value="#222222"/>
            <Setter Property="Foreground" Value="#A0A0A0"/>
            <Setter Property="BorderBrush" Value="#303030"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, sans-serif"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#2A2A2A"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#444444"/>
                                <Setter Property="Foreground" Value="#EEEEEE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#191919"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#303030"/>
                                <Setter Property="Foreground" Value="#A0A0A0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Neutral Primary Action Button (Tactile monochromatic styling) -->
        <Style x:Key="PrimaryActionButton" TargetType="Button">
            <Setter Property="Background" Value="#2E2E2E"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, sans-serif"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#383838"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#555555"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#222222"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#333333"/>
                                <Setter Property="Foreground" Value="#A0A0A0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compatibility alias for GreenActionButton mapped to neutral PrimaryActionButton -->
        <Style x:Key="GreenActionButton" BasedOn="{StaticResource PrimaryActionButton}" TargetType="Button"/>

        <!-- Neutral Secondary Action Button -->
        <Style x:Key="SecondaryActionButton" TargetType="Button">
            <Setter Property="Background" Value="#222222"/>
            <Setter Property="Foreground" Value="#A0A0A0"/>
            <Setter Property="BorderBrush" Value="#303030"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, sans-serif"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#2A2A2A"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#444444"/>
                                <Setter Property="Foreground" Value="#EEEEEE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#191919"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#303030"/>
                                <Setter Property="Foreground" Value="#A0A0A0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom ComboBox ToggleButton Style (Strict Monochromatic) -->
        <ControlTemplate x:Key="ComboBoxToggleButtonTemplate" TargetType="ToggleButton">
            <Border x:Name="TemplateRoot"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                    </Grid.ColumnDefinitions>
                    <Path x:Name="Arrow"
                          Grid.Column="1"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Data="M 0 0 L 3 3 L 6 0 Z"
                          Fill="#A0A0A0"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="TemplateRoot" Property="Background" Value="#2A2A2A"/>
                    <Setter TargetName="TemplateRoot" Property="BorderBrush" Value="#444444"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="#EEEEEE"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="TemplateRoot" Property="Background" Value="#222222"/>
                    <Setter TargetName="TemplateRoot" Property="BorderBrush" Value="#505050"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="#EEEEEE"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="TemplateRoot" Property="Opacity" Value="0.4"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Neutral ComboBoxItem Style -->
        <Style x:Key="DarkComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A0A0A0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, sans-serif"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                CornerRadius="3"
                                Margin="2,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2A2A2A"/>
                                <Setter Property="Foreground" Value="#EEEEEE"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#303030"/>
                                <Setter Property="Foreground" Value="#EEEEEE"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Dark Year ComboBox Style (Neutral Charcoal, No Red Outline) -->
        <Style x:Key="DarkYearComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#222222"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="BorderBrush" Value="#303030"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, sans-serif"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItemStyle}"/>
            <Setter Property="Validation.ErrorTemplate" Value="{x:Null}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="MainGrid" SnapsToDevicePixels="True">
                            <ToggleButton x:Name="ToggleButton"
                                          Template="{StaticResource ComboBoxToggleButtonTemplate}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          FocusVisualStyle="{x:Null}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"/>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="7,2,16,2"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder"
                                        Background="#222222"
                                        BorderBrush="#303030"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        MinWidth="{Binding ActualWidth, ElementName=MainGrid}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Padding="2"
                                        Margin="0,2,0,0"
                                        SnapsToDevicePixels="True">
                                    <ScrollViewer x:Name="DropDownScrollViewer" CanContentScroll="True">
                                        <ItemsPresenter x:Name="ItemsPresenter"
                                                        KeyboardNavigation.DirectionalNavigation="Contained"
                                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="DropDownBorder" Property="Height" Value="0"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="#444444"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Widget Surface: Strict Neutral Dark Charcoal with Subtle Border -->
    <Border Background="#191919"
            BorderBrush="#303030"
            BorderThickness="1"
            CornerRadius="10"
            Padding="16,12"
            SnapsToDevicePixels="True">
        <Grid>
            <!-- Active Verified Widget Surface (Visible only when IsAccountVerified == true) -->
            <Grid Visibility="{Binding IsAccountVerified, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Row 0: Top Bar with Brand & Drag Grip -->
                    <RowDefinition Height="Auto"/> <!-- Row 1: Hero Section (Identity + Stats + Controls/Streak) -->
                    <RowDefinition Height="Auto"/> <!-- Row 2: Activity Header Line -->
                    <RowDefinition Height="*"/>    <!-- Row 3: Heatmap -->
                    <RowDefinition Height="Auto"/> <!-- Row 4: Footer (Telemetry & Legend) -->
                </Grid.RowDefinitions>

                <!-- Row 0: Top Bar (Branding & Drag Handle Only - No Clutter) -->
                <DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="True">
                    <!-- Left: Brand Drag Handle -->
                    <StackPanel x:Name="HeaderBrandDragArea"
                                Orientation="Horizontal"
                                DockPanel.Dock="Left"
                                Background="Transparent"
                                Cursor="SizeAll"
                                ToolTip="Click and drag to move widget"
                                MouseLeftButtonDown="OnDragHandleMouseLeftButtonDown"
                                VerticalAlignment="Center">
                        <Ellipse x:Name="DesktopStatusDot" Width="7.5" Height="7.5" Fill="#606060" Margin="0,0,7,0" VerticalAlignment="Center" ToolTip="Desktop Layer"/>
                        <TextBlock Text="LEETCODE" 
                                   FontSize="10" 
                                   FontWeight="Bold" 
                                   Foreground="#A0A0A0" 
                                   FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text=" ⋮⋮" 
                                   FontSize="11" 
                                   FontWeight="Bold" 
                                   Foreground="#505050" 
                                   FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
                                   VerticalAlignment="Center"
                                   Margin="4,0,0,0"/>
                    </StackPanel>

                    <!-- Center: Drag Fill Area -->
                    <Border x:Name="HeaderCenterDragArea" 
                            Background="Transparent" 
                            Cursor="SizeAll" 
                            ToolTip="Click and drag to move widget"
                            MouseLeftButtonDown="OnDragHandleMouseLeftButtonDown"/>
                </DockPanel>

                <!-- Row 1: Neutral Clean Hero Section (Space Reclaimed from Removed Illustration) -->
                <Grid Grid.Row="1" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>    <!-- Col 0: Identity, Solved Count, Inline Difficulty -->
                        <ColumnDefinition Width="Auto"/> <!-- Col 1: Year/Refresh Controls & Neutral Streak Box -->
                    </Grid.ColumnDefinitions>

                    <!-- Col 0: Identity, Solved Counter & Inline Neutral Difficulty -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <!-- Identity Row -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Display Mode -->
                            <StackPanel Orientation="Horizontal" 
                                        Visibility="{Binding IsEditingUsername, Converter={StaticResource InverseBoolToVis}}"
                                        VerticalAlignment="Center">
                                <TextBlock Text="@" FontSize="13" FontWeight="Normal" Foreground="#707070" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding DisplayUsername}" 
                                           FontSize="14" 
                                           FontWeight="Bold" 
                                           Foreground="#EEEEEE" 
                                           FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                                           VerticalAlignment="Center"
                                           Cursor="Hand"
                                           MaxWidth="260"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="Click to change username">
                                    <TextBlock.InputBindings>
                                        <MouseBinding Gesture="LeftClick" Command="{Binding ToggleEditUsernameCommand}"/>
                                    </TextBlock.InputBindings>
                                </TextBlock>
                                <Button Content="✎" 
                                        Command="{Binding ToggleEditUsernameCommand}" 
                                        ToolTip="Change LeetCode Username"
                                        Style="{StaticResource DarkIconButton}" 
                                        Margin="6,0,0,0" 
                                        Padding="4,1"
                                        FontSize="9"/>

                                <!-- Subtle Neutral Verified Pill -->
                                <Border Visibility="{Binding IsAccountVerified, Converter={StaticResource BoolToVis}}"
                                        Background="#222222" BorderBrush="#303030" BorderThickness="1" CornerRadius="3"
                                        Padding="6,1.5" Margin="8,0,0,0" VerticalAlignment="Center"
                                        ToolTip="{Binding VerificationBadgeTooltip}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="4.5" Height="4.5" Fill="#A0A0A0" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="verified" FontSize="9" FontWeight="SemiBold" Foreground="#A0A0A0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Edit Mode -->
                            <StackPanel Orientation="Horizontal" 
                                        Visibility="{Binding IsEditingUsername, Converter={StaticResource BoolToVis}}"
                                        VerticalAlignment="Center">
                                <TextBox x:Name="UsernameInputBox"
                                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource DarkInputBox}"
                                         Width="150" 
                                         FontSize="11" 
                                         Padding="4,2">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Return" Command="{Binding SaveUsernameCommand}"/>
                                        <KeyBinding Key="Enter" Command="{Binding SaveUsernameCommand}"/>
                                        <KeyBinding Key="Esc" Command="{Binding CancelEditUsernameCommand}"/>
                                        <KeyBinding Key="Escape" Command="{Binding CancelEditUsernameCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                                <Button Content="✓" 
                                        Command="{Binding SaveUsernameCommand}" 
                                        ToolTip="Save (Enter)"
                                        Style="{StaticResource DarkIconButton}" 
                                        Margin="4,0,0,0" 
                                        Padding="6,1"/>
                                <Button Content="✕" 
                                        Command="{Binding CancelEditUsernameCommand}" 
                                        ToolTip="Cancel (Esc)"
                                        Style="{StaticResource DarkIconButton}" 
                                        Margin="3,0,0,0" 
                                        Padding="6,1"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Solved Metric & Understated Single-Line Difficulty Breakdown -->
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0" VerticalAlignment="Center">
                            <!-- Prominent Solved Metric -->
                            <TextBlock Text="{Binding TotalSolved}" FontSize="22" FontWeight="Bold" Foreground="#EEEEEE" VerticalAlignment="Center"/>
                            <TextBlock Text="SOLVED" FontSize="10" FontWeight="Bold" Foreground="#707070" Margin="5,0,16,0" VerticalAlignment="Center"/>

                            <!-- Understated Neutral Difficulty on Single Line -->
                            <TextBlock Text="{Binding EasySolved}" FontSize="11" FontWeight="SemiBold" Foreground="#EEEEEE" VerticalAlignment="Center"/>
                            <TextBlock Text=" easy" FontSize="11" Foreground="#A0A0A0" VerticalAlignment="Center"/>
                            <TextBlock Text="  ·  " FontSize="11" Foreground="#444444" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding MediumSolved}" FontSize="11" FontWeight="SemiBold" Foreground="#EEEEEE" VerticalAlignment="Center"/>
                            <TextBlock Text=" medium" FontSize="11" Foreground="#A0A0A0" VerticalAlignment="Center"/>
                            <TextBlock Text="  ·  " FontSize="11" Foreground="#444444" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding HardSolved}" FontSize="11" FontWeight="SemiBold" Foreground="#EEEEEE" VerticalAlignment="Center"/>
                            <TextBlock Text=" hard" FontSize="11" Foreground="#A0A0A0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Col 1: Year Selector, Refresh & Neutral Streak Box -->
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- Controls Row: Year Dropdown & Refresh Button -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,4">
                            <ComboBox ItemsSource="{Binding AvailableYears}"
                                      SelectedItem="{Binding SelectedYear}"
                                      Visibility="{Binding HasAvailableYears, Converter={StaticResource BoolToVis}}"
                                      Style="{StaticResource DarkYearComboBox}"
                                      Width="72"
                                      Height="24"
                                      Margin="0,0,6,0"
                                      Focusable="False"/>

                            <Button Content="↻" 
                                    Command="{Binding RefreshCommand}" 
                                    IsEnabled="{Binding IsSyncing, Converter={StaticResource InverseBoolToVis}}"
                                    ToolTip="Refresh from LeetCode"
                                    Style="{StaticResource DarkIconButton}" 
                                    Width="26" Height="24"
                                    FontSize="11"
                                    FontWeight="Bold"/>
                        </StackPanel>

                        <!-- Neutral Monochromatic Streak Box -->
                        <Border Background="#222222" BorderBrush="#303030" BorderThickness="1" CornerRadius="4" Padding="8,3" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🔥" FontSize="11" Foreground="#EEEEEE" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding CurrentStreak}" FontSize="12.5" FontWeight="Bold" Foreground="#EEEEEE" VerticalAlignment="Center"/>
                                <TextBlock Text=" DAY STREAK" FontSize="9.5" FontWeight="SemiBold" Foreground="#A0A0A0" Margin="3,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock Text="  ·  " FontSize="10" Foreground="#444444" Margin="3,0" VerticalAlignment="Center"/>
                                <TextBlock Text="MAX " FontSize="9" FontWeight="Normal" Foreground="#A0A0A0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding LongestStreak, Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="#EEEEEE" VerticalAlignment="Center"/>
                                <TextBlock Text="D" FontSize="9" FontWeight="Normal" Foreground="#A0A0A0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Row 2: Subtle Activity Header Line -->
                <DockPanel Grid.Row="2" Margin="2,6,2,3">
                    <TextBlock Text="activity" FontSize="10" FontWeight="SemiBold" Foreground="#A0A0A0" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                    <Rectangle Height="1" Fill="#303030" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </DockPanel>

                <!-- Row 3: Heatmap Grid Canvas -->
                <views:HeatmapControl Grid.Row="3"
                                      Activity="{Binding CurrentActivity}"
                                      HoveredSubmission="{Binding HoveredDay, Mode=TwoWay}"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      Margin="0,1"/>

                <!-- Row 4: Footer: Selected-Year Telemetry & Contribution Legend -->
                <DockPanel Grid.Row="4" Margin="2,4,2,0">
                    <!-- Selected-Year Telemetry & Hover Info -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedYear}" FontSize="10" FontWeight="Bold" Foreground="#EEEEEE"/>
                        <TextBlock Text=" activity  ·  " FontSize="10" Foreground="#707070"/>
                        <TextBlock Text="{Binding YearSubmissions}" FontSize="10" FontWeight="SemiBold" Foreground="#EEEEEE"/>
                        <TextBlock Text=" submissions  ·  " FontSize="10" Foreground="#707070"/>
                        <TextBlock Text="{Binding YearActiveDays}" FontSize="10" FontWeight="SemiBold" Foreground="#EEEEEE"/>
                        <TextBlock Text=" active days  ·  " FontSize="10" Foreground="#707070"/>
                        <TextBlock Text="{Binding YearAverageText}" FontSize="10" FontWeight="SemiBold" Foreground="#EEEEEE"/>
                        <TextBlock Text="/day avg" FontSize="10" Foreground="#707070"/>

                        <!-- Soft Divider -->
                        <TextBlock Text="  |  " FontSize="10" Foreground="#303030" Margin="6,0"/>

                        <!-- Hover Info Text -->
                        <TextBlock Text="{Binding HoverInfoText}" 
                                   FontSize="10" 
                                   Foreground="#A0A0A0" 
                                   MaxWidth="260"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- Right: 5-Level Contribution Legend -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="Less" FontSize="9" Foreground="#707070" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <Rectangle Width="9" Height="9" RadiusX="1.5" RadiusY="1.5" Fill="#222222" Stroke="#303030" StrokeThickness="0.8" Margin="2,0"/>
                        <Rectangle Width="9" Height="9" RadiusX="1.5" RadiusY="1.5" Fill="#0E3A22" Margin="2,0"/>
                        <Rectangle Width="9" Height="9" RadiusX="1.5" RadiusY="1.5" Fill="#186334" Margin="2,0"/>
                        <Rectangle Width="9" Height="9" RadiusX="1.5" RadiusY="1.5" Fill="#238C44" Margin="2,0"/>
                        <Rectangle Width="9" Height="9" RadiusX="1.5" RadiusY="1.5" Fill="#2EB856" Margin="2,0"/>
                        <TextBlock Text="More" FontSize="9" Foreground="#707070" Margin="5,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Grid>

            <!-- Minimal Onboarding Surface (Visible only when IsAccountVerified == false) -->
            <Grid Visibility="{Binding IsAccountVerified, Converter={StaticResource InverseBoolToVis}}"
                  VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="500">
                    <!-- Brand Drag Handle -->
                    <StackPanel x:Name="OnboardingBrandDragArea" 
                                Orientation="Horizontal" 
                                HorizontalAlignment="Center" 
                                Background="Transparent"
                                Cursor="SizeAll"
                                ToolTip="Click and drag to move widget"
                                MouseLeftButtonDown="OnDragHandleMouseLeftButtonDown"
                                Margin="0,0,0,16">
                        <Ellipse x:Name="OnboardingStatusDot" Width="7.5" Height="7.5" Fill="#606060" Margin="0,0,7,0" VerticalAlignment="Center" ToolTip="Desktop Layer"/>
                        <TextBlock Text="LEETCODE" 
                                   FontSize="10" 
                                   FontWeight="Bold" 
                                   Foreground="#A0A0A0" 
                                   FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text=" ⋮⋮" 
                                   FontSize="11" 
                                   FontWeight="Bold" 
                                   Foreground="#505050" 
                                   FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
                                   VerticalAlignment="Center"
                                   Margin="4,0,0,0"/>
                    </StackPanel>

                    <!-- Title -->
                    <TextBlock Text="CONNECT YOUR ACCOUNT" 
                               FontSize="14" 
                               FontWeight="Bold" 
                               Foreground="#EEEEEE" 
                               FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                               HorizontalAlignment="Center" 
                               Margin="0,0,0,6"/>

                    <!-- Subtitle / Explanation -->
                    <TextBlock Text="Your activity and streaks will appear here once your account is verified."
                               FontSize="11"
                               Foreground="#A0A0A0"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0,0,0,16"/>

                    <!-- Input + Action -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                        <TextBox x:Name="OnboardingUsernameBox"
                                 Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DarkInputBox}"
                                 Width="200"
                                 FontSize="11.5"
                                 Padding="8,5"
                                 ToolTip="Enter LeetCode username">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding StartVerificationCommand}"/>
                                <KeyBinding Key="Enter" Command="{Binding StartVerificationCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Content="Verify Ownership"
                                Command="{Binding StartVerificationCommand}"
                                Style="{StaticResource PrimaryActionButton}"
                                Margin="8,0,0,0"
                                FontSize="11.5"/>
                    </StackPanel>

                    <!-- Status / Error Text -->
                    <TextBlock Text="{Binding VerificationStatusText}"
                               Visibility="{Binding VerificationStatusText, Converter={StaticResource StringNotEmptyToVis}}"
                               FontSize="10.5"
                               Foreground="#A0A0A0"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="440"
                               TextAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- Account Ownership Verification Overlay -->
            <Border Background="#191919" 
                    BorderBrush="#303030" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Visibility="{Binding IsVerificationPromptOpen, Converter={StaticResource BoolToVis}}"
                    Padding="22,14"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="True">
                        <StackPanel x:Name="OverlayDragArea"
                                    Orientation="Horizontal" 
                                    DockPanel.Dock="Left" 
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    Cursor="SizeAll"
                                    ToolTip="Click and drag to move widget"
                                    MouseLeftButtonDown="OnDragHandleMouseLeftButtonDown">
                            <TextBlock Text="ACCOUNT OWNERSHIP VERIFICATION" FontSize="10.5" FontWeight="Bold" Foreground="#EEEEEE"/>
                            <TextBlock Text=" — @" FontSize="10.5" Foreground="#707070"/>
                            <TextBlock Text="{Binding Username}" FontSize="11" FontWeight="Bold" Foreground="#EEEEEE"/>
                            <TextBlock Text=" ⋮⋮" FontSize="11" FontWeight="Bold" Foreground="#505050" Margin="5,0,0,0"/>
                        </StackPanel>
                        <Button Content="✕" 
                                Command="{Binding CancelVerificationCommand}" 
                                DockPanel.Dock="Right" 
                                HorizontalAlignment="Right"
                                Style="{StaticResource DarkIconButton}" 
                                Padding="6,1" 
                                FontSize="10" 
                                ToolTip="Close (Esc)"/>
                    </DockPanel>

                    <!-- Instructions -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,8">
                        <!-- Step 1: Copy Token -->
                        <TextBlock Text="1. Copy your temporary challenge token below (valid for 15 minutes):" 
                                   FontSize="10.5" Foreground="#A0A0A0" Margin="0,0,0,4"/>
                        <Border Background="#222222" BorderBrush="#303030" BorderThickness="1" CornerRadius="4" Padding="10,4" Margin="0,0,0,8">
                            <DockPanel>
                                <Button Content="📋 Copy" 
                                        Command="{Binding CopyVerificationTokenCommand}" 
                                        DockPanel.Dock="Right" 
                                        Style="{StaticResource DarkIconButton}" 
                                        Padding="10,3" 
                                        Margin="8,0,0,0" 
                                        FontSize="10.5" 
                                        FontWeight="SemiBold"/>
                                <TextBox Text="{Binding VerificationToken, Mode=OneWay}" 
                                         IsReadOnly="True" 
                                         Background="Transparent" 
                                         Foreground="#EEEEEE" 
                                         FontFamily="Consolas, monospace" 
                                         FontSize="11.5" 
                                         BorderThickness="0" 
                                         VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>

                        <!-- Step 2: Open LeetCode Profile Button -->
                        <DockPanel Margin="0,0,0,6">
                            <Button Content="↗ Open LeetCode Profile" 
                                    Command="{Binding OpenLeetCodeProfileCommand}"
                                    DockPanel.Dock="Right"
                                    Style="{StaticResource SecondaryActionButton}"
                                    Padding="10,3"
                                    Margin="8,0,0,0"
                                    FontSize="10.5"
                                    FontWeight="SemiBold"
                                    ToolTip="Opens https://leetcode.com/profile in your default browser"/>
                            <TextBlock Text="2. Paste the token into your LeetCode profile 'About Me' bio:" 
                                       FontSize="10.5" Foreground="#A0A0A0" VerticalAlignment="Center"/>
                        </DockPanel>

                        <!-- Step 3: Save and Verify -->
                        <TextBlock Text="3. Click 'Save' on LeetCode, then click 'Verify Ownership' below." 
                                   FontSize="10.5" Foreground="#A0A0A0" Margin="0,0,0,2"/>
                        <TextBlock Text="(You can safely remove the token from your profile immediately after verification.)" 
                                   FontSize="9.5" FontStyle="Italic" Foreground="#707070"/>
                    </StackPanel>

                    <!-- Status message -->
                    <TextBlock Grid.Row="2" 
                               Text="{Binding VerificationStatusText}" 
                               FontSize="10.5" 
                               Foreground="#A0A0A0" 
                               TextWrapping="Wrap" 
                               Margin="0,0,0,8"/>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" 
                                Command="{Binding CancelVerificationCommand}" 
                                Style="{StaticResource DarkIconButton}" 
                                Margin="0,0,8,0" 
                                Padding="12,4" 
                                FontSize="11"/>
                        <Button Content="Verify Ownership" 
                                Command="{Binding CheckVerificationCommand}" 
                                IsEnabled="{Binding IsVerifying, Converter={StaticResource InverseBoolToVis}}"
                                Style="{StaticResource PrimaryActionButton}"
                                Padding="16,4" 
                                FontSize="11"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
