<Window x:Class="LeetCodeDesktopWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:LeetCodeDesktopWidget.Views"
        xmlns:vm="clr-namespace:LeetCodeDesktopWidget.ViewModels"
        xmlns:helpers="clr-namespace:LeetCodeDesktopWidget.Helpers"
        mc:Ignorable="d"
        Title="LeetCode Desktop Widget"
        Height="275" Width="845"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="False"
        WindowStartupLocation="Manual"
        Left="60" Top="60"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.BitmapScalingMode="HighQuality"
        RenderOptions.ClearTypeHint="Enabled"
        MouseMove="OnWindowMouseMove"
        MouseLeftButtonUp="OnWindowMouseLeftButtonUp"
        LostMouseCapture="OnWindowLostMouseCapture"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=False}">

    <Window.Resources>
        <helpers:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:BooleanToVisibilityConverter x:Key="InverseBoolToVis" Invert="True"/>
        <helpers:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVis"/>

        <!-- Dark minimal ToolTip -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#161B22"/>
            <Setter Property="Foreground" Value="#C9D1D9"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, sans-serif"/>
        </Style>

        <!-- Dark minimal ComboBox -->
        <Style x:Key="DarkYearComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#21262D"/>
            <Setter Property="Foreground" Value="#C9D1D9"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, sans-serif"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Dark minimal Button -->
        <Style x:Key="DarkIconButton" TargetType="Button">
            <Setter Property="Background" Value="#21262D"/>
            <Setter Property="Foreground" Value="#C9D1D9"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, sans-serif"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>
    </Window.Resources>

    <Border Background="#F00D1117"
            BorderBrush="#30363D"
            BorderThickness="1"
            CornerRadius="10"
            Padding="14,12"
            SnapsToDevicePixels="True">
        <Grid>
            <!-- Active Verified Widget Surface (Visible only when IsAccountVerified == true) -->
            <Grid Visibility="{Binding IsAccountVerified, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0: Header with Username, All-Time Solved Breakdown, and Streaks -->
                <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="True">
                <!-- Left: Branding & Username -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <!-- Brand Drag Handle -->
                    <StackPanel x:Name="HeaderBrandDragArea"
                                Orientation="Horizontal"
                                Background="Transparent"
                                Cursor="SizeAll"
                                ToolTip="Click and drag to move widget"
                                MouseLeftButtonDown="OnDragHandleMouseLeftButtonDown"
                                VerticalAlignment="Center">
                        <Ellipse x:Name="DesktopStatusDot" Width="9" Height="9" Fill="#238636" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="Desktop Layer"/>
                        <TextBlock Text="LEETCODE" 
                                   FontSize="11.5" 
                                   FontWeight="Bold" 
                                   Foreground="#8B949E" 
                                   FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text=" ⋮⋮" 
                                   FontSize="11.5" 
                                   FontWeight="Bold" 
                                   Foreground="#484F58" 
                                   FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
                                   VerticalAlignment="Center"
                                   Margin="3,0,0,0"/>
                    </StackPanel>

                    <!-- Username Display Mode -->
                    <StackPanel Orientation="Horizontal" 
                                Visibility="{Binding IsEditingUsername, Converter={StaticResource InverseBoolToVis}}"
                                Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayUsername}" 
                                   FontSize="11" 
                                   Foreground="#58A6FF" 
                                   VerticalAlignment="Center"
                                   Cursor="Hand"
                                   MaxWidth="130"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="Click to edit username">
                            <TextBlock.InputBindings>
                                <MouseBinding Gesture="LeftClick" Command="{Binding ToggleEditUsernameCommand}"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                        <Button Content="✎" 
                                Command="{Binding ToggleEditUsernameCommand}" 
                                ToolTip="Change LeetCode Username"
                                Style="{StaticResource DarkIconButton}" 
                                Margin="6,0,0,0" 
                                Padding="4,1"
                                FontSize="9"/>

                        <!-- Verified Badge -->
                        <Border Visibility="{Binding IsAccountVerified, Converter={StaticResource BoolToVis}}"
                                Background="#0E4429" BorderBrush="#238636" BorderThickness="1" CornerRadius="3"
                                Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center"
                                ToolTip="{Binding VerificationBadgeTooltip}">
                            <TextBlock Text="✓ Verified" FontSize="9.5" FontWeight="SemiBold" Foreground="#3FB950"/>
                        </Border>

                        <!-- Unverified / Verify Button -->
                        <Button Visibility="{Binding IsAccountVerified, Converter={StaticResource InverseBoolToVis}}"
                                Command="{Binding StartVerificationCommand}"
                                ToolTip="{Binding VerificationBadgeTooltip}"
                                Style="{StaticResource DarkIconButton}" 
                                Margin="6,0,0,0" 
                                Padding="5,1" 
                                BorderBrush="#D29922">
                            <TextBlock Text="Verify Ownership" FontSize="9.5" Foreground="#D29922"/>
                        </Button>
                    </StackPanel>

                    <!-- Username Edit Mode -->
                    <StackPanel Orientation="Horizontal" 
                                Visibility="{Binding IsEditingUsername, Converter={StaticResource BoolToVis}}"
                                Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBox x:Name="UsernameInputBox"
                                 Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" 
                                 Width="120" 
                                 FontSize="11" 
                                 Background="#161B22" 
                                 Foreground="#C9D1D9" 
                                 BorderBrush="#30363D" 
                                 Padding="4,2">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding SaveUsernameCommand}"/>
                                <KeyBinding Key="Enter" Command="{Binding SaveUsernameCommand}"/>
                                <KeyBinding Key="Esc" Command="{Binding CancelEditUsernameCommand}"/>
                                <KeyBinding Key="Escape" Command="{Binding CancelEditUsernameCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Content="✓" 
                                Command="{Binding SaveUsernameCommand}" 
                                ToolTip="Save (Enter)"
                                Style="{StaticResource DarkIconButton}" 
                                Margin="4,0,0,0" 
                                Padding="6,1"/>
                        <Button Content="✕" 
                                Command="{Binding CancelEditUsernameCommand}" 
                                ToolTip="Cancel (Esc)"
                                Style="{StaticResource DarkIconButton}" 
                                Margin="3,0,0,0" 
                                Padding="6,1"/>
                    </StackPanel>
                </StackPanel>

                <!-- Right: All-time Stats Badges & Controls -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Difficulty Breakdown Badge -->
                    <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Solved: " FontSize="10.5" Foreground="#8B949E"/>
                            <TextBlock Text="{Binding TotalSolved}" FontSize="10.5" FontWeight="SemiBold" Foreground="#C9D1D9" Margin="0,0,6,0"/>
                            <TextBlock Text="E:" FontSize="10" Foreground="#8B949E"/>
                            <TextBlock Text="{Binding EasySolved}" FontSize="10" Foreground="#3FB950" Margin="1,0,5,0"/>
                            <TextBlock Text="M:" FontSize="10" Foreground="#8B949E"/>
                            <TextBlock Text="{Binding MediumSolved}" FontSize="10" Foreground="#D29922" Margin="1,0,5,0"/>
                            <TextBlock Text="H:" FontSize="10" Foreground="#8B949E"/>
                            <TextBlock Text="{Binding HardSolved}" FontSize="10" Foreground="#F85149" Margin="1,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- All-time Current & Longest Streak -->
                    <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Streak: " FontSize="10.5" Foreground="#8B949E"/>
                            <TextBlock Text="{Binding CurrentStreak}" FontSize="10.5" FontWeight="SemiBold" Foreground="#D29922"/>
                            <TextBlock Text="d " FontSize="10.5" Foreground="#8B949E"/>
                            <TextBlock Text="(Max: " FontSize="10" Foreground="#6E7681"/>
                            <TextBlock Text="{Binding LongestStreak}" FontSize="10" Foreground="#E3B341"/>
                            <TextBlock Text="d)" FontSize="10" Foreground="#6E7681"/>
                        </StackPanel>
                    </Border>

                    <!-- Year Dropdown -->
                    <ComboBox ItemsSource="{Binding AvailableYears}"
                              SelectedItem="{Binding SelectedYear}"
                              Visibility="{Binding HasAvailableYears, Converter={StaticResource BoolToVis}}"
                              Style="{StaticResource DarkYearComboBox}"
                              Width="72"
                              Margin="0,0,6,0"
                              Focusable="False"/>

                    <!-- Refresh Button -->
                    <Button Content="↻" 
                            Command="{Binding RefreshCommand}" 
                            IsEnabled="{Binding IsSyncing, Converter={StaticResource InverseBoolToVis}}"
                            ToolTip="Refresh from LeetCode"
                            Style="{StaticResource DarkIconButton}" 
                            Padding="7,2" 
                            FontWeight="Bold"/>
                </StackPanel>

                <!-- Center: Drag Fill Area -->
                <Border x:Name="HeaderCenterDragArea" 
                        Background="Transparent" 
                        Cursor="SizeAll" 
                        ToolTip="Click and drag to move widget"
                        MouseLeftButtonDown="OnDragHandleMouseLeftButtonDown"
                        Margin="8,0"/>
            </DockPanel>

            <!-- Row 1: Heatmap Grid Canvas -->
            <views:HeatmapControl Grid.Row="1"
                                  Activity="{Binding CurrentActivity}"
                                  HoveredSubmission="{Binding HoveredDay, Mode=TwoWay}"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"/>

            <!-- Row 2: Selected-Year Detailed Statistics Strip -->
            <Border Grid.Row="2" Margin="0,6,0,0" Padding="0,3" BorderBrush="#21262D" BorderThickness="0,1,0,0">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedYear}" FontSize="10.5" FontWeight="SemiBold" Foreground="#58A6FF"/>
                        <TextBlock Text=" Activity:" FontSize="10.5" Foreground="#8B949E" Margin="0,0,8,0"/>

                        <TextBlock Text="{Binding YearSubmissions}" FontSize="10.5" FontWeight="SemiBold" Foreground="#C9D1D9"/>
                        <TextBlock Text=" submissions  •  " FontSize="10.5" Foreground="#6E7681"/>

                        <TextBlock Text="{Binding YearActiveDays}" FontSize="10.5" FontWeight="SemiBold" Foreground="#C9D1D9"/>
                        <TextBlock Text=" active days  •  " FontSize="10.5" Foreground="#6E7681"/>

                        <TextBlock Text="Avg " FontSize="10" Foreground="#6E7681"/>
                        <TextBlock Text="{Binding YearAverageText}" FontSize="10.5" FontWeight="SemiBold" Foreground="#C9D1D9"/>
                        <TextBlock Text="/day  •  " FontSize="10" Foreground="#6E7681"/>

                        <TextBlock Text="Best: " FontSize="10" Foreground="#6E7681"/>
                        <TextBlock Text="{Binding MostActiveDayText}" FontSize="10.5" FontWeight="SemiBold" Foreground="#3FB950"/>
                        <TextBlock Text="  •  " FontSize="10" Foreground="#6E7681"/>

                        <TextBlock Text="Year Streak: " FontSize="10" Foreground="#6E7681"/>
                        <TextBlock Text="{Binding YearLongestStreak}" FontSize="10.5" FontWeight="SemiBold" Foreground="#D29922"/>
                        <TextBlock Text="d" FontSize="10.5" Foreground="#8B949E"/>
                    </StackPanel>

                    <!-- Sync Status / Last Sync Time -->
                    <TextBlock Text="{Binding SyncStatusText}" 
                               FontSize="10" 
                               Foreground="#6E7681" 
                               DockPanel.Dock="Right"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               MaxWidth="260"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding SyncStatusText}"
                               FontFamily="Segoe UI Variable, Segoe UI, sans-serif"/>
                </DockPanel>
            </Border>

            <!-- Row 3: Footer: Hover Feedback & 5-Level Legend -->
            <DockPanel Grid.Row="3" Margin="0,6,0,0">
                <!-- Hover Date / Count Feedback -->
                <TextBlock Text="{Binding HoverInfoText}" 
                           FontSize="11" 
                           Foreground="#8B949E" 
                           DockPanel.Dock="Left"
                           VerticalAlignment="Center"
                           MaxWidth="450"
                           TextTrimming="CharacterEllipsis"
                           FontFamily="Segoe UI Variable, Segoe UI, sans-serif"/>

                <!-- 5-Level Contribution Legend -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Less" FontSize="10" Foreground="#6E7681" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="#161B22" Stroke="#21262D" StrokeThickness="0.5" Margin="2,0"/>
                    <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="#0E4429" Margin="2,0"/>
                    <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="#006D32" Margin="2,0"/>
                    <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="#26A641" Margin="2,0"/>
                    <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="#39D353" Margin="2,0"/>
                    <TextBlock Text="More" FontSize="10" Foreground="#6E7681" Margin="5,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Grid>

        <!-- Minimal Onboarding Surface (Visible only when IsAccountVerified == false) -->
        <Grid Visibility="{Binding IsAccountVerified, Converter={StaticResource InverseBoolToVis}}"
              VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Brand -->
                <StackPanel x:Name="OnboardingBrandDragArea" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Center" 
                            Background="Transparent"
                            Cursor="SizeAll"
                            ToolTip="Click and drag to move widget"
                            MouseLeftButtonDown="OnDragHandleMouseLeftButtonDown"
                            Margin="0,0,0,8">
                    <Ellipse x:Name="OnboardingStatusDot" Width="9" Height="9" Fill="#238636" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="Desktop Layer"/>
                    <TextBlock Text="LEETCODE" 
                               FontSize="11.5" 
                               FontWeight="Bold" 
                               Foreground="#8B949E" 
                               FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
                               VerticalAlignment="Center"/>
                    <TextBlock Text=" ⋮⋮" 
                               FontSize="11.5" 
                               FontWeight="Bold" 
                               Foreground="#484F58" 
                               FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
                               VerticalAlignment="Center"
                               Margin="3,0,0,0"/>
                </StackPanel>

                <!-- Title -->
                <TextBlock Text="Connect your account" 
                           FontSize="16" 
                           FontWeight="SemiBold" 
                           Foreground="#C9D1D9" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,14"/>

                <!-- Input + Action -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <TextBox x:Name="OnboardingUsernameBox"
                             Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                             Width="190"
                             FontSize="12"
                             Background="#161B22"
                             Foreground="#C9D1D9"
                             BorderBrush="#30363D"
                             BorderThickness="1"
                             Padding="8,5"
                             VerticalContentAlignment="Center"
                             ToolTip="Enter LeetCode username">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding StartVerificationCommand}"/>
                            <KeyBinding Key="Enter" Command="{Binding StartVerificationCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Content="Verify Ownership"
                            Command="{Binding StartVerificationCommand}"
                            Background="#238636"
                            Foreground="#FFFFFF"
                            BorderBrush="#2EA043"
                            BorderThickness="1"
                            Padding="14,5"
                            Margin="8,0,0,0"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Focusable="False"/>
                </StackPanel>

                <!-- Subtitle / Warning -->
                <TextBlock Text="Your account must be verified before activity is displayed."
                           FontSize="11"
                           Foreground="#8B949E"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>

                <!-- Status / Error Text -->
                <TextBlock Text="{Binding VerificationStatusText}"
                           Visibility="{Binding VerificationStatusText, Converter={StaticResource StringNotEmptyToVis}}"
                           FontSize="11"
                           Foreground="#E3B341"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="450"
                           TextAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Account Ownership Verification Overlay -->
        <Border Background="#FA0D1117" 
                CornerRadius="8" 
                Visibility="{Binding IsVerificationPromptOpen, Converter={StaticResource BoolToVis}}"
                Padding="20,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel x:Name="OverlayDragArea"
                                    Orientation="Horizontal" 
                                    DockPanel.Dock="Left" 
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    Cursor="SizeAll"
                                    ToolTip="Click and drag to move widget"
                                    MouseLeftButtonDown="OnDragHandleMouseLeftButtonDown">
                            <TextBlock Text="ACCOUNT OWNERSHIP VERIFICATION" FontSize="11" FontWeight="Bold" Foreground="#8B949E"/>
                            <TextBlock Text=" — @" FontSize="11" Foreground="#6E7681"/>
                            <TextBlock Text="{Binding Username}" FontSize="11" FontWeight="SemiBold" Foreground="#58A6FF"/>
                            <TextBlock Text=" ⋮⋮" FontSize="11" FontWeight="Bold" Foreground="#484F58" Margin="4,0,0,0"/>
                        </StackPanel>
                        <Button Content="✕" 
                                Command="{Binding CancelVerificationCommand}" 
                                DockPanel.Dock="Right" 
                                HorizontalAlignment="Right"
                                Style="{StaticResource DarkIconButton}" 
                                Padding="6,1" 
                                FontSize="10" 
                                ToolTip="Close"/>
                    </DockPanel>

                    <!-- Instructions -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,8">
                        <TextBlock Text="To verify that you own this LeetCode account, follow these 3 steps:" 
                                   FontSize="11" Foreground="#C9D1D9" Margin="0,0,0,6"/>
                        
                        <TextBlock Text="1. Copy your temporary challenge token below (valid for 15 minutes):" 
                                   FontSize="10.5" Foreground="#8B949E" Margin="0,0,0,4"/>
                        
                        <!-- Token Box + Copy Button -->
                        <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,0,6">
                            <DockPanel>
                                <Button Content="📋 Copy" 
                                        Command="{Binding CopyVerificationTokenCommand}" 
                                        DockPanel.Dock="Right" 
                                        Style="{StaticResource DarkIconButton}" 
                                        Padding="8,2" 
                                        Margin="8,0,0,0" 
                                        FontSize="10" 
                                        FontWeight="SemiBold"/>
                                <TextBox Text="{Binding VerificationToken, Mode=OneWay}" 
                                         IsReadOnly="True" 
                                         Background="Transparent" 
                                         Foreground="#3FB950" 
                                         FontFamily="Consolas, monospace" 
                                         FontSize="11" 
                                         BorderThickness="0" 
                                         VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>

                        <TextBlock Text="2. Go to leetcode.com/profile and paste this token into your 'About Me' bio." 
                                   FontSize="10.5" Foreground="#8B949E" Margin="0,0,0,4"/>
                        <TextBlock Text="3. Click 'Save' on LeetCode, then click 'Verify Ownership' below." 
                                   FontSize="10.5" Foreground="#8B949E" Margin="0,0,0,2"/>
                        <TextBlock Text="(Once verified, you can immediately remove the token from your profile bio.)" 
                                   FontSize="9.5" FontStyle="Italic" Foreground="#6E7681"/>
                    </StackPanel>

                    <!-- Status message -->
                    <TextBlock Grid.Row="2" 
                               Text="{Binding VerificationStatusText}" 
                               FontSize="10.5" 
                               Foreground="#E3B341" 
                               TextWrapping="Wrap" 
                               Margin="0,0,0,8"/>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" 
                                Command="{Binding CancelVerificationCommand}" 
                                Style="{StaticResource DarkIconButton}" 
                                Margin="0,0,8,0" 
                                Padding="12,4" 
                                FontSize="11"/>
                        <Button Content="Verify Ownership" 
                                Command="{Binding CheckVerificationCommand}" 
                                IsEnabled="{Binding IsVerifying, Converter={StaticResource InverseBoolToVis}}"
                                Background="#238636" 
                                Foreground="#FFFFFF" 
                                BorderBrush="#2EA043" 
                                BorderThickness="1" 
                                Padding="14,4" 
                                FontSize="11" 
                                FontWeight="SemiBold" 
                                Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
